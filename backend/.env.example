LEGALINTEL_APP_NAME=LegalIntel API
# Legacy /chat only. AI uses /api/v1/ai/turn and its own settings below.
LEGALINTEL_REPLY_MODE=stub
LEGALINTEL_CORS_ORIGINS=["http://localhost:8081","http://127.0.0.1:8081"]
LEGALINTEL_KNOWLEDGE_DB=data/knowledge.sqlite3
LEGALINTEL_ACCOUNTS_DB=data/accounts.sqlite3
LEGALINTEL_AUTH_SESSION_DAYS=30
# False for this local HTTP MVP.
LEGALINTEL_AUTH_COOKIE_SECURE=false
# LEGALINTEL_KNOWLEDGE_CORPUS=knowledge

# Free cloud starter: create your own key, paste it ONLY here, restart backend.
# An empty key produces an explicit error, never a fake AI response.
# Alternatives: ollama, compatible (strict JSON Schema), disabled.
LEGALINTEL_AI_PROVIDER=groq
LEGALINTEL_AI_MODEL=qwen/qwen3.8-27b
LEGALINTEL_AI_API_KEY=
# Leave empty for the provider default. Ollama: http://127.0.0.1:11434
# Compatible APIs: full base ending in /v1, without /chat/completions.
LEGALINTEL_AI_BASE_URL=
LEGALINTEL_AI_TIMEOUT_SECONDS=60
LEGALINTEL_AI_MAX_OUTPUT_TOKENS=1536
# Shared application limit, per UTC day. Counts model calls, including failures.
# One text message normally makes two calls. This is NOT a money-spend limit.
LEGALINTEL_AI_MAX_CALLS_PER_DAY=100
LEGALINTEL_AI_USAGE_DB=data/ai_usage.sqlite3
LEGALINTEL_AI_CONTEXT_CHARS=6000
LEGALINTEL_AI_OLLAMA_CONTEXT=8192
