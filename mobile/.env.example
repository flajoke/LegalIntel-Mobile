# Optional. If empty, a local address is chosen for the current platform.
# Android emulator: http://10.0.2.2:8000
# iOS simulator / browser: http://127.0.0.1:8000
# Physical phone: http://YOUR_COMPUTER_LAN_IP:8000
# Connection settings are not shown in the demo UI. Restart Expo after changing this value.
EXPO_PUBLIC_API_URL=
# Development allows local HTTP in a native build. Never put secrets in EXPO_PUBLIC_*.
APP_ENV=development
